RETENTION_DAYS=30
MAX_FILE_SIZE_MB=200
MAX_TOTAL_STORAGE_MB=5000
#HEARTH_PAIRING_CODE=
HEARTH_DB_PATH=/opt/hearth/data/hearth.db
HEARTH_FILES_DIR=/opt/hearth/data/files

# Serving: http (default, LAN-friendly, no certs needed) or https.
# In https mode, uvicorn terminates TLS itself (Caddy not required) and
# both cert files must exist or startup fails.
#HEARTH_SERVE=http
#HEARTH_BIND=0.0.0.0
#HEARTH_PORT=8000
#HEARTH_TLS_CERT=/etc/hearth/certs/host.pem
#HEARTH_TLS_KEY=/etc/hearth/certs/host-key.pem

